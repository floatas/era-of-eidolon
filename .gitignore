# Third-party emulators, cloned or downloaded — not ours to version, and 55MB
tools/freej2me/
tools/freej2me-web/
tools/freej2me.zip
tools/cfr.jar
tools/vineflower.jar

# Build output of our own shims (sources ARE tracked)
tools/freej2me-net/**/*.class
tools/freej2me-web-net/**/*.class

# Repacked jars — regenerated by run/play.sh from jars/. The originals in
# jars/ are the irreplaceable part and stay tracked.
run/EoE-*.jar
run/EoE-*.jad

# Runtime state
server/capture/
server/logs/
server/saves/
server/__pycache__/
rms/
freej2me_system/

.DS_Store

# Per-game emulator settings, written by FreeJ2ME at runtime
config/

# Plain `unzip` output of the jars — regenerate with:
#   for j in jars/*.jar; do unzip -o -q "$j" -d "extracted/$(basename "$j" .jar)"; done
extracted/

# Rendered maps — derived from the jars, regenerate with:
#   python3 tools/render_map.py ShiradsForge && python3 tools/render_map.py SterlingLake
assets/maps/

# MicroEmulator jars, fetched from Maven Central:
#   for a in microemu-javase microemu-cldc microemu-midp microemu-device-large; do
#     curl -O https://repo1.maven.org/maven2/org/microemu/$a/2.0.4/$a-2.0.4.jar
#   done
tools/microemu/
