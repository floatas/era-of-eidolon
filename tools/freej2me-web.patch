+    <script>
+        // The panel is a reference, not a follower. It used to poll for the
+        // room the player was in, which the server can only know when some
+        // request happens to carry it — and under CheerpJ the client's
+        // map-loaded ping never arrives at all, so it sat on a stale room.
+        // Everything here is fetched once and browsed.
+        const tabs = document.getElementById("book-tabs");
+        const list = document.getElementById("book-list");
+        const entry = document.getElementById("book-entry");
+        let sections = [], current = 0;
+
+        function showList(n) {
+            current = n;
+            entry.hidden = true;
+            list.hidden = false;
+            for (const b of tabs.children) {
+                b.setAttribute("aria-current", b.dataset.n === String(n) ? "true" : "false");
+            }
+            list.replaceChildren();
+            for (const e of sections[n].entries) {
+                const li = document.createElement("li");
+                const b = document.createElement("button");
+                b.type = "button";
+                b.textContent = e.title;
+                b.addEventListener("click", () => showEntry(e));
+                li.append(b);
+                list.append(li);
+            }
+        }
+        function showEntry(e) {
+            list.hidden = true;
+            entry.hidden = false;
+            document.getElementById("entry-title").textContent = e.title;
+            const box = document.getElementById("entry-lines");
+            box.replaceChildren();
+            for (const line of e.lines) {
+                const p = document.createElement("p");
+                p.textContent = line;
+                box.append(p);
+            }
+            entry.scrollTop = 0;
+        }
+        document.getElementById("book-back")
+            .addEventListener("click", () => showList(current));
+
+        // Loaded when the page opens and again each time the panel is opened,
+        // so the Trophies tab shows what the hero has earned since. The tab
+        // you were on stays selected; an entry you were reading stays open.
+        // The Refresh button, and every few seconds while the panel is open,
+        // ask again. Nothing is redrawn unless the answer changed, so the list
+        // does not jump under the reader.
+        let lastBook = "";
+        const updated = document.getElementById("book-updated");
+        async function loadBook() {
+            try {
+                const res = await fetch("/compendium", {cache: "no-store"});
+                if (!res.ok) return;
+                const text = await res.text();
+                updated.textContent = "Updated " + new Date().toLocaleTimeString();
+                if (text === lastBook) return;
+                lastBook = text;
+                const reading = !entry.hidden;
+                sections = JSON.parse(text).sections || [];
+                tabs.replaceChildren();
+                sections.forEach((sec, n) => {
+                    const b = document.createElement("button");
+                    b.type = "button";
+                    b.dataset.n = String(n);
+                    b.textContent = sec.name;
+                    b.addEventListener("click", () => showList(n));
+                    tabs.append(b);
+                });
+                if (!sections.length) return;
+                if (current >= sections.length) current = 0;
+                if (reading) {
+                    for (const b of tabs.children) {
+                        b.setAttribute("aria-current", b.dataset.n === String(current) ? "true" : "false");
+                    }
+                } else {
+                    showList(current);
+                }
+            } catch (err) {}
+        }
+        loadBook();
+        document.getElementById("book-refresh").addEventListener("click", loadBook);
+        setInterval(() => {
+            if (document.body.classList.contains("compendium-open")
+                    && document.visibilityState === "visible") {
+                loadBook();
+            }
+        }, 8000);
+
+        const panelToggle = document.getElementById("panel-toggle");
+        function setBookOpen(open) {
+            if (open) loadBook();
+            document.body.classList.toggle("compendium-open", open);
+            panelToggle.setAttribute("aria-expanded", open ? "true" : "false");
+            localStorage.setItem("eoe.compendium", open ? "open" : "closed");
+            window.dispatchEvent(new Event("resize"));
+        }
+        panelToggle.setAttribute(
+            "aria-expanded",
+            document.body.classList.contains("compendium-open") ? "true" : "false");
+        panelToggle.addEventListener("click", () => {
+            setBookOpen(!document.body.classList.contains("compendium-open"));
+            const display = document.getElementById("display");
+            if (display) display.focus();
+        });
+    </script>
