+	static boolean typingJar(String name) {
+		if (name == null) {
+			return false;
+		}
+		String n = name.toLowerCase();
+		return n.indexOf("badaz") >= 0 || n.indexOf("blackjack") >= 0
+				|| n.indexOf("orumant") >= 0 || n.indexOf("dagonar") >= 0;
+	}
+
+	/** Arrows, Enter, Escape, Backspace, and real characters. Digits stay phone keys. */
+	boolean applyTypingKey(KeyEvent e) {
+		int code = e.code;
+		int mapped;
+		if (code == KeyEvent.VK_UP) mapped = -1;
+		else if (code == KeyEvent.VK_DOWN) mapped = -2;
+		else if (code == KeyEvent.VK_LEFT) mapped = -3;
+		else if (code == KeyEvent.VK_RIGHT) mapped = -4;
+		else if (code == KeyEvent.VK_ENTER) mapped = -5;
+		else if (code == KeyEvent.VK_ESCAPE) mapped = -7;
+		else if (code == KeyEvent.VK_BACK_SPACE || code == KeyEvent.VK_DELETE) mapped = 8;
+		else {
+			char ch = e.keyChar;
+			boolean digit = ch >= '0' && ch <= '9'
+					&& ((code >= KeyEvent.VK_0 && code <= KeyEvent.VK_9)
+						|| (code >= KeyEvent.VK_NUMPAD0 && code <= KeyEvent.VK_NUMPAD9));
+			if (digit || (ch >= 32 && ch <= 126)) {
+				mapped = ch;
+			} else {
+				return false;
+			}
+		}
+		e.platformCode = mapped;
+		e.normalizedCode = Mobile.normalizeKey(mapped);
+		return true;
+	}
+
+	void dispatchTyping(KeyEvent e, boolean down) {
+		int slot = (e.platformCode + 64) & 0x7F;
+		if (!down) {
+			if (e.platformCode != 0) {
+				pressedKeys[slot] = false;
+			}
+			Mobile.getPlatform().keyReleased(e);
+			return;
+		}
+		boolean held = pressedKeys[slot];
+		int key = e.platformCode;
+		// A held letter or Backspace should keep typing. Arrow repeat stays a repeat.
+		if (!held || key == 8 || (key >= 32 && key <= 126)) {
+			Mobile.getPlatform().keyPressed(e);
+		} else {
+			Mobile.getPlatform().keyRepeated(e);
+		}
+		if (e.platformCode != 0) {
+			pressedKeys[slot] = true;
+		}
+	}
+
 }
